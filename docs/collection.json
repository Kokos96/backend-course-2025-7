					"mode": "formdata",
					"formdata": [
						{ "key": "inventory_name", "value": "Postman Test Device", "type": "text" },
						{ "key": "description", "value": "Тестуємо реєстрацію через Postman", "type": "text" },
						{ "key": "photo", "type": "file", "src": [] }
